{
  "name": "teamcodex",
  "version": "1.3.0",
  "description": "Four multi-account proxies (Claude Code, Codex, Antigravity agy, Grok) from one codebase. Quota-aware account rotation, zero dependencies.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "teamclaude": "src/teamclaude.js",
    "teamcodex": "src/index.js"
  },
  "files": [
    "src/",
    "config.example.json",
    "config.codex.example.json"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "test:hud": "for t in test/hud/test_*.py statusline/test_statusline.py; do python3 \"$t\" || exit 1; done && bash statusline/test_install.sh",
    "lint": "eslint ."
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "codex",
    "openai",
    "chatgpt",
    "proxy",
    "load-balancer",
    "multi-account",
    "rate-limit",
    "quota",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cineraria01/teamproxy.git"
  },
  "homepage": "https://github.com/cineraria01/teamproxy#readme",
  "bugs": {
    "url": "https://github.com/cineraria01/teamproxy/issues"
  },
  "author": "Sangrok Jung",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
